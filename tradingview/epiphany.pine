//@version=6
// The five agents.surf strategies that run on one TradingView chart, plus RSI(2) pullback, IBS + trend and Double 7s (default: 67% win rate in the benchmark).
// Ported from the equations (#37, #4, #38, #40, #81), long-only to match the Alpaca paper endpoint.
// ponytail: no price stop, a stop fill draws no label and the bot would miss the exit.
// Draws BUY / SELL labels that scripts/tv-signal-agent.js turns into orders.
strategy("Epiphany", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05, margin_long = 0, margin_short = 0)

mode   = input.string("Double 7s", "Strategy", options = ["Single MA", "Two MA", "Three MA", "Donchian", "IBS", "RSI2 pullback", "IBS + trend", "Double 7s"])
t1     = input.int(20,  "Fast / single MA length", minval = 1)
t2     = input.int(50,  "Mid / slow MA length", minval = 1)
t3     = input.int(200, "Slow MA length (Three MA)", minval = 1)
chanT  = input.int(20,  "Donchian lookback", minval = 2)
ibsLo  = input.float(0.2, "IBS buy below", step = 0.05)
ibsHi  = input.float(0.8, "IBS sell above", step = 0.05)
rsiIn  = input.float(10, "RSI(2) buy below", step = 1)
rsiOut = input.int(5, "RSI2 exit: close above SMA", minval = 1)
d7     = input.int(10, "Double 7s lookback", minval = 2)

ma1 = ta.sma(close, t1)
ma2 = ta.sma(close, t2)
ma3 = ta.sma(close, t3)
// Channel excludes the current bar so a new high can actually break it.
up = ta.highest(high, chanT)[1]
dn = ta.lowest(low, chanT)[1]
ibs = high > low ? (close - low) / (high - low) : 0.5
r2 = ta.rsi(close, 2)
ma200 = ta.sma(close, 200)
maX = ta.sma(close, rsiOut)
lo7 = ta.lowest(close, d7)
hi7 = ta.highest(close, d7)

longIn = switch mode
    "Single MA" => close > ma1
    "Two MA"    => ma1 > ma2
    "Three MA"  => ma1 > ma2 and ma2 > ma3
    "Donchian"  => close >= up
    "IBS"       => ibs < ibsLo
    "RSI2 pullback" => close > ma200 and r2 < rsiIn
    "IBS + trend"   => close > ma200 and ibs < ibsLo
    "Double 7s"     => close > ma200 and close <= lo7
longOut = switch mode
    "Single MA" => close < ma1
    "Two MA"    => ma1 < ma2
    "Three MA"  => ma1 <= ma2
    "Donchian"  => close <= dn
    "IBS"       => ibs > ibsHi
    "RSI2 pullback" => close > maX
    "IBS + trend"   => ibs > ibsHi
    "Double 7s"     => close >= hi7

flat = strategy.position_size == 0
if longIn and flat
    strategy.entry("L", strategy.long, comment = " ")
    // Green up arrow = BUY, red down arrow = SELL. Text is hidden but tv-signal-agent.js reads it.
    label.new(bar_index, low, "BUY", style = label.style_triangleup, size = size.small, color = color.new(#16a34a, 0), textcolor = color.new(color.white, 100))
else if longOut and not flat
    strategy.close("L", comment = " ")
    label.new(bar_index, high, "SELL", style = label.style_triangledown, size = size.small, color = color.new(#dc2626, 0), textcolor = color.new(color.white, 100))

plot(mode == "Donchian" ? na : ma1, "MA1", color.black)
plot(mode == "Two MA" or mode == "Three MA" ? ma2 : na, "MA2", color.gray)
plot(mode == "Three MA" ? ma3 : na, "MA3", color.silver)
plot(mode == "Donchian" ? up : na, "Channel up", color.black)
plot(mode == "Donchian" ? dn : na, "Channel down", color.gray)
