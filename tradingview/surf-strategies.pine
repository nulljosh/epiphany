//@version=6
// The five agents.surf strategies that run on one TradingView chart.
// Ported from the equations (#37, #4, #38, #40, #81), long-only to match the Alpaca paper endpoint.
// ponytail: no price stop, a stop fill draws no label and the bot would miss the exit.
// Draws BUY / SELL labels that scripts/tv-signal-agent.js turns into orders.
strategy("Surf Strategies", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05)

mode   = input.string("Two MA", "Strategy", options = ["Single MA", "Two MA", "Three MA", "Donchian", "IBS"])
t1     = input.int(20,  "Fast / single MA length", minval = 1)
t2     = input.int(50,  "Mid / slow MA length", minval = 1)
t3     = input.int(200, "Slow MA length (Three MA)", minval = 1)
chanT  = input.int(20,  "Donchian lookback", minval = 2)
ibsLo  = input.float(0.2, "IBS buy below", step = 0.05)
ibsHi  = input.float(0.8, "IBS sell above", step = 0.05)

ma1 = ta.sma(close, t1)
ma2 = ta.sma(close, t2)
ma3 = ta.sma(close, t3)
// Channel excludes the current bar so a new high can actually break it.
up = ta.highest(high, chanT)[1]
dn = ta.lowest(low, chanT)[1]
ibs = high > low ? (close - low) / (high - low) : 0.5

longIn = switch mode
    "Single MA" => close > ma1
    "Two MA"    => ma1 > ma2
    "Three MA"  => ma1 > ma2 and ma2 > ma3
    "Donchian"  => close >= up
    "IBS"       => ibs < ibsLo
longOut = switch mode
    "Single MA" => close < ma1
    "Two MA"    => ma1 < ma2
    "Three MA"  => ma1 <= ma2
    "Donchian"  => close <= dn
    "IBS"       => ibs > ibsHi

flat = strategy.position_size == 0
if longIn and flat
    strategy.entry("L", strategy.long)
    label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.black, textcolor = color.white)
else if longOut and not flat
    strategy.close("L")
    label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.black, textcolor = color.white)

plot(mode == "Donchian" ? na : ma1, "MA1", color.black)
plot(mode == "Two MA" or mode == "Three MA" ? ma2 : na, "MA2", color.gray)
plot(mode == "Three MA" ? ma3 : na, "MA3", color.silver)
plot(mode == "Donchian" ? up : na, "Channel up", color.black)
plot(mode == "Donchian" ? dn : na, "Channel down", color.gray)
