devices([
  "iPhone 11 Pro Max",
  "iPhone 14 Plus"
])

languages([
  "en-US"
])

scheme("Epiphany")

# ponytail: default concurrent_simulators runs both devices' xcodebuild +
# simulator boot at once, which pegs the machine. One at a time is slower
# but doesn't fight for CPU/RAM.
concurrent_simulators(false)

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

override_status_bar(true)

# Xcode won't auto-trust the SwiftLint SPM build-tool plugin in a non-interactive
# run, which fails the build before any screenshot is captured.
xcargs("-skipPackagePluginValidation -skipMacroValidation")
